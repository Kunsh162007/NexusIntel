# ═══════════════════════════════════════════════════════════════
# NexusIntel AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ── Bright Data ──────────────────────────────────────────────────
# Get these from https://brightdata.com → Account → Credentials
# Your $250 hackathon credit (code: unlocked) covers all 5 products.

# API token (used for REST API calls like Web Scraper API)
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token

# Customer ID (shown in your proxy zone credentials)
BRIGHT_DATA_CUSTOMER_ID=hl_xxxxxxxx

# Web Unlocker zone — defeats CAPTCHAs and bot detection
BRIGHT_DATA_UNLOCKER_ZONE=unlocker
BRIGHT_DATA_UNLOCKER_PASSWORD=your_unlocker_zone_password

# SERP — automatically reuses the unlocker zone, no separate zone needed
# Leave these blank unless you create a dedicated SERP zone
BRIGHT_DATA_SERP_ZONE=
BRIGHT_DATA_SERP_PASSWORD=

# Scraping Browser zone — JavaScript-rendered pages
BRIGHT_DATA_BROWSER_ZONE=scraping_browser
BRIGHT_DATA_BROWSER_PASSWORD=your_browser_zone_password

# ── AI/ML API (aimlapi.com) ───────────────────────────────────────
# Get your $10 credit at https://aimlapi.com → API Keys
AIML_API_KEY=your_aimlapi_key
AIML_API_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini
AIML_EMBEDDING_MODEL=text-embedding-3-small

# ── Cognee (Agent Memory) ─────────────────────────────────────────
# Get partner access at https://cognee.ai
# If left blank, NexusIntel uses an in-memory fallback graph.
COGNEE_API_KEY=
COGNEE_DB_PATH=./cognee_data

# ── TriggerWare.ai (Action Layer) ────────────────────────────────
# Get partner access at https://triggerware.ai
TRIGGERWARE_API_KEY=
TRIGGERWARE_BASE_URL=https://api.triggerware.ai
# Optional: any webhook URL to receive alerts (Slack, CRM, etc.)
TRIGGERWARE_WEBHOOK_URL=

# ── Speechmatics (Voice) ─────────────────────────────────────────
# Get your $200 credit (code: WEBDATAHACK200) at https://speechmatics.com
# If left blank, Speechmatics returns a demo transcript.
SPEECHMATICS_API_KEY=

# ── Engine settings ───────────────────────────────────────────────
# How often the Auto-Focus Engine checks each URL (seconds)
ENGINE_CHECK_INTERVAL_SECONDS=300
# Cosine similarity threshold below which an anomaly is flagged
ANOMALY_SIMILARITY_THRESHOLD=0.85
# Set to true to skip auto-start of the engine (use demo buttons instead)
DEMO_MODE=false

# ── App ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=change-me-in-production
